programa {
  funcao inicio() {
    
    inteiro numero [5],soma
    para(inteiro i = 0;i<5;i++){
      escreva("\nDigite uma senha ")
    }
    soma == numero[0]+ numero[4] 
    se(soma==numero[2]){
      escreva("Senha correta")
    }
      senao{
        escreva("Senha incorreta")
      }
      
    }
  }

