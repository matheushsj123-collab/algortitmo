programa {
  funcao inicio() {
    cadeia nomes[5]={"matheus","joao","pedro","gustavo","daniel"}
    cadeia verificar[5]
    inteiro i 
    logico la=verdadeiro
    para(i=0;i<5;i++){
      escreva("\nDigite seu nome para verificar:")
      leia(verificar[i])
      se(nome[i] == la){
        escreva("Acahado no índice X")

      }
      senao{
        escreva("Não achei")

      }
    }
    
  }
}
